-- Dark City RP: unlimited running stamina.
-- Restore every frame so sprint stamina never drains while running.
CreateThread(function()
    while true do
        RestorePlayerStamina(PlayerId(), 1.0)
        Wait(0)
    end
end)



-- Settings V16 live preference loop.
CreateThread(function()
    local lastRadarState = nil
    while true do
        local showRadar = false
        if minimapMode == 'always' then
            showRadar = true
        elseif minimapMode == 'vehicle' then
            showRadar = IsPedInAnyVehicle(PlayerPedId(), false)
        end

        if adminCinematic.active and adminCinematic.flags.map then showRadar = false end
        DisplayRadar(showRadar)
        SetRadarBigmapEnabled(false, false)
        lastRadarState = showRadar
        Wait(0)
    end
end)

CreateThread(function()
    while true do
        if adminCinematic.active then
            DisplayHud(not adminCinematic.flags.nativeHud)
            Wait(0)
        else
            Wait(500)
        end
    end
end)
RegisterNetEvent('QBCore:Client:OnPlayerUnload', function()
    DisplayRadar(false)
end)






-- [dc-core-ui] stuck spawn timeout recovery.
-- dc-character hides/freezes the player until spawn selection completes. If a
-- worldmanager callback/NUI race drops the completion, restore gameplay instead
-- of leaving the client on a black screen forever.
CreateThread(function()
    Wait(3000)
    while true do
        Wait(1000)
        if spawnPending and not uiOpen and spawnActionStartedAt > 0 then
            if (GetGameTimer() - spawnActionStartedAt) > 6000 then
                spawnPending = false
                spawnActionStartedAt = 0
                currentView = Config.DefaultView or 'statisticsTab'
                forceEmergencySpawn(vector4(-1037.65, -2737.84, 20.17, 330.0), 'Airport Recovery', 'spawn-timeout')
            end
        end
    end
end)
-- [dc-core-ui] resource stop cleanup.
-- A restart must never leave the client in the old spawn fade/camera/focus state.
AddEventHandler('onResourceStop', function(resourceName)
    if resourceName ~= GetCurrentResourceName() then return end
    spawnPending = false
    uiOpen = false
    spawnActionStartedAt = 0
    spawnOnlyAirport = false
    if type(DestroyAllCams) == 'function' then pcall(function() DestroyAllCams(true) end) end
    pcall(function() RenderScriptCams(false, false, 0, true, true) end)
    pcall(function() ClearFocus() end)
    pcall(function() ClearTimecycleModifier() end)
    pcall(function() SetNuiFocus(false, false) end)
    pcall(function() SendNUIMessage({ action = 'close' }) end)
    local ped = PlayerPedId()
    if DoesEntityExist(ped) then
        FreezeEntityPosition(ped, false)
        SetEntityVisible(ped, true, false)
        SetEntityAlpha(ped, 255, false)
        SetEntityCollision(ped, true, true)
        SetPlayerInvincible(PlayerId(), false)
        SetPlayerControl(PlayerId(), true, 0)
        ClearPedTasksImmediately(ped)
    end
    ShutdownLoadingScreen()
    ShutdownLoadingScreenNui()
    DoScreenFadeIn(500)
end)








