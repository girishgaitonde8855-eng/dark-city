-- Debug/test helpers for spawn UI issues.
RegisterCommand('openspawn', function()
    openUi('spawnSelect')
end, false)

RegisterCommand('fixspawn', function()
    CreateThread(function()
        print('[dc-core-ui] /fixspawn normal spawn recovery started')
        spawnPending = false
        spawnActionStartedAt = 0
        spawnOnlyAirport = false
        currentView = Config.DefaultView or 'statisticsTab'
        uiOpen = false
        SetNuiFocus(false, false)
        nui({ action = 'close' })
        if type(DestroyAllCams) == 'function' then pcall(function() DestroyAllCams(true) end) end
        pcall(function() RenderScriptCams(false, false, 0, true, true) end)
        pcall(function() StopPlayerSwitch() end)
        pcall(function() NetworkSetInSpectatorMode(false, PlayerPedId()) end)
        pcall(function() SetCinematicModeActive(false) end)
        pcall(function() StopGameplayCamShaking(true) end)
        pcall(function() ClearTimecycleModifier() end)
        finishSpawnAt(vector4(-1037.65, -2737.84, 20.17, 330.0), 'Airport Recovery', 'airport')
        print('[dc-core-ui] /fixspawn normal spawn recovery finished')
    end)
end, false)
RegisterCommand('forcespawn', function(_, args)
    doSpawn(args[1] or 'airport')
end, false)

RegisterCommand(Config.Commands.Hud or 'togglehud', function()
    hudVisible = not hudVisible
    nui({ action = 'hudVisible', value = hudVisible })
end)

RegisterNetEvent('dc-core-ui:client:Spawn', function(id)
    doSpawn(id or 'last')
end)

RegisterNetEvent('dc-core-ui:client:RespawnHospital', function()
    -- dc-ambulance owns the authoritative death screen and timer.
    if GetResourceState('dc-ambulance') == 'started' then
        safeNotify('Use the Dark City death screen; hospital respawn unlocks after the timer.', 'error')
        return
    end
    local ok, err = pcall(function()
        local ped = PlayerPedId()
        local c = Config.HospitalRespawn
        DoScreenFadeOut(500)
        Wait(800)
        NetworkResurrectLocalPlayer(c.x, c.y, c.z, c.w or 0.0, true, false)
        SetEntityHealth(ped, 200)
        ClearPedBloodDamage(ped)
        SetEntityCoords(ped, c.x, c.y, c.z, false, false, false, true)
        SetEntityHeading(ped, c.w or 0.0)
        DoScreenFadeIn(500)
        closeUi()
    end)
    if not ok then
        safePrint('RespawnHospital error: '..tostring(err))
    end
end)

-- Safety: never leave ordinary players permanently invincible after a resource/update.
-- Green-zone protection remains authoritative when dc-worldmanager reports a green zone.
CreateThread(function()
    while true do
        Wait(1500)
        local ped = PlayerPedId()
        if ped and ped ~= 0 and not IsEntityDead(ped) then
            local green = false
            if GetResourceState('dc-worldmanager') == 'started' then
                local ok, zone = pcall(function() return exports['dc-worldmanager']:GetCurrentZone() end)
                if ok and tostring(zone or '') == 'green' then green = true end
            end
            if not green and GetPlayerInvincible(PlayerId()) then
                SetPlayerInvincible(PlayerId(), false)
                SetEntityInvincible(ped, false)
                SetEntityCanBeDamaged(ped, true)
                SetEntityProofs(ped, false, false, false, false, false, false, false, false)
            end
        end
    end
end)

CreateThread(function()
    while true do
        if Config.HudEnabled and hudVisible then
            cbData('hud', function(data)
                nui({ action = 'hud', data = data })
            end)
        end
        Wait(Config.HudRefreshMs or 1000)
    end
end)

CreateThread(function()
    while true do
        local ok, err = pcall(function()
            local ped = PlayerPedId()
            if IsEntityDead(ped) and not lastDeathShown then
                lastDeathShown = true
                cbData('deathScreen', function(data)
                    -- Death screen must replace any open M Menu view.
                    uiOpen = false
                    SetNuiFocus(false, false)
                    nui({ action = 'close' })
                    Wait(80)
                    SetNuiFocus(true, true)
                    nui({ action = 'open', view = 'deathScreen', data = data })
                end)
            elseif not IsEntityDead(ped) and lastDeathShown then
                lastDeathShown = false
                nui({ action = 'deathOff' })
            end
        end)
        if not ok then
            safePrint('death thread error: '..tostring(err))
        end
        Wait(750)
    end
end)

RegisterNetEvent('QBCore:Client:OnPlayerLoaded', function()
    CreateThread(function()
        Wait(Config.AuthDelayMs or 2500)
        hudVisible = true
        loadPersistentSettings('player-loaded')
        cbData('hud', function(data)
            nui({ action = 'hud', data = data })
        end)

        -- Spawn Select is opened only by dc-character before the final spawn.
        -- PlayerLoaded now initializes HUD/auth only, preventing duplicate spawn menus.

        -- Keep old auth available only when spawn selector is disabled manually later.
        if Config.AuthOnJoin and not authShownThisSession and Config.ForceAuthInsteadOfSpawn then
            authShownThisSession = true
            openUi('auth')
        end
    end)
end)

-- Spawn recovery watchdog: prevents a missed NUI/resource event from leaving the player in a permanent black fade.
CreateThread(function()
    Wait(12000)
    while true do
        Wait(1500)
        local pd = QBCore.Functions.GetPlayerData() or {}
        if pd.citizenid and pd.citizenid ~= '' then
            if spawnPending and uiOpen and spawnUiOpenedAt > 0 and (GetGameTimer() - spawnUiOpenedAt) > 5000 then
                -- Repaint a lost NUI canvas without unlocking the mandatory spawn hand-off.
                SetNuiFocus(true, true)
                nui({ action = 'open', view = 'spawnSelect', data = fallbackData('spawnSelect') })
                spawnUiOpenedAt = GetGameTimer()
            elseif not spawnPending and not uiOpen then
                local ped = PlayerPedId()
                if IsScreenFadedOut() or not IsEntityVisible(ped) then
                    releaseSpawnLock()
                    ShutdownLoadingScreen()
                    ShutdownLoadingScreenNui()
                end
            end
        end
    end
end)

AddEventHandler('onResourceStart', function(resourceName)
    if resourceName == GetCurrentResourceName() then
        CreateThread(function()
            -- Resource may be restarted while the player is already online,
            -- in which case QBCore:Client:OnPlayerLoaded will not fire again.
            for _ = 1, 40 do
                local pd = QBCore.Functions.GetPlayerData() or {}
                if pd.citizenid and pd.citizenid ~= '' then
                    Wait(1500)
                    loadPersistentSettings('core-resource-start')
                    releaseSpawnLock()
                    return
                end
                Wait(500)
            end
        end)
    elseif resourceName == 'dc-chat' then
        SetTimeout(750, function()
            if appliedSettings.chat_visible ~= nil then applyClientSetting('chat_visible', appliedSettings.chat_visible) end
            if appliedSettings.chat_scale ~= nil then applyClientSetting('chat_scale', appliedSettings.chat_scale) end
            if appliedSettings.chat_vertical ~= nil then applyClientSetting('chat_vertical', appliedSettings.chat_vertical) end
        end)
    elseif resourceName == 'dc-notify' then
        SetTimeout(750, function()
            if appliedSettings.notification_position ~= nil then applyClientSetting('notification_position', appliedSettings.notification_position) end
            if appliedSettings.notification_sound ~= nil then applyClientSetting('notification_sound', appliedSettings.notification_sound) end
            if adminCinematic.active then
                cinematicNotifyVisibility(not adminCinematic.flags.notifications)
                cinematicTutorialVisibility(not adminCinematic.flags.hud)
            end
        end)
    end
end)

RegisterNetEvent('QBCore:Client:OnPlayerUnload', function()
    settingsLoadSerial = settingsLoadSerial + 1
    dataCache['settings'] = nil
    appliedSettings = {}
    if adminCinematic.active then
        cinematicRestore()
    else
        DisplayHud(true)
    end
end)

RegisterNetEvent('dc-core-ui:client:ReloadSettings', function()
    loadPersistentSettings('server-request')
end)

RegisterNetEvent('dc-core-ui:client:ShowSharedNumber', function(data)
    data = type(data) == 'table' and data or {}
    nui({
        action = 'phase1:sharedNumber',
        name = tostring(data.name or 'Nearby player'),
        number = tostring(data.number or ''),
        duration = math.max(3, math.min(30, tonumber(data.duration or 10) or 10))
    })
end)

